# Supabase Postgres, owner role, used by ingest jobs only (never by the web app).
# Use the *Session pooler* string (Project > Connect): the direct host is IPv6-only and GitHub runners have no IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SEC requires a real contact in the User-Agent: "Full Name email@example.com"
EDGAR_USER_AGENT="Your Name you@example.com"

# Web app: read-only market_sql_app role (db/roles.sql). Written by: python db/set_app_password.py
APP_DATABASE_URL=postgresql://market_sql_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# LLM: any OpenAI-compatible endpoint. Pick one preset.
# Ollama (local dev + eval, free). Run first: ollama pull qwen2.5-coder:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
# Groq (deployed demo, free tier): key from console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
# Gemini (fallback, free tier): key from aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
