# Supabase Postgres, owner role, used by ingest jobs only.
# Use the *Session pooler* string (Project > Connect): the direct host is IPv6-only and GitHub runners have no IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SEC requires a real contact in the User-Agent: "Full Name email@example.com"
EDGAR_USER_AGENT="Your Name you@example.com"
