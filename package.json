{
  "name": "market-sql",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file=.env eval/run.mts",
    "lint": "eslint .",
    "eval:groq": "node --env-file=.env -e \"process.env.LLM_BASE_URL='https://api.groq.com/openai/v1';process.env.LLM_MODEL='openai/gpt-oss-120b';process.env.LLM_API_KEY=process.env.GROQ_API_KEY;process.env.EVAL_DELAY_MS??='20000';require('child_process').execSync('npx tsx eval/run.mts',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "next": "^16.4.6",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
